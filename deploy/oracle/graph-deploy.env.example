# Copy to /etc/helekh/graph-deploy.env. The file is sourced by the script: shell assignments only, no secrets are needed.
# Leave false until the activation is authorized: 'check' works, 'apply' and 'rollback' refuse.
DEPLOY_ENABLED=false
ACTIVE_GRAPH=/home/opc/graph.obj
STATE_DIR=/home/opc/graph-deploy
OTP_CONTAINER=helekh-otp
JOURNEY_CONTAINER=helekh-journey
